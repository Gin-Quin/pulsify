{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"ignore": ["**/node_modules/**"],
		"include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"]
	},
	"linter": {
		"rules": {
			"style": {
				"noUselessElse": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"correctness": {
				"noUnreachable": "warn",
				"noUnusedImports": { "fix": "safe", "level": "info" }
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
