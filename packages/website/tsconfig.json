{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vite/client", "@solidjs/start/env"],
		"paths": { "~/*": ["./src/*"] }
	},
	"include": ["src", "vite.config.ts"]
}
