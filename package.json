{
	"name": "pulsify-workspace",
	"private": true,
	"workspaces": [
		"packages/*",
		"packages/connectors/*",
		"benchmarks"
	],
	"scripts": {
		"dev": "bun examples/server.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test packages/pulse/tests packages/pulsify-codemirror/tests packages/pulsify-prosemirror/tests packages/pulsify-lexical/tests packages/cloud-server/core/tests packages/cloud-server/cloudflare/tests packages/cloud-server/unikraft-cloud/tests packages/cloud-service/tests packages/connectors/IndexedDB/tests packages/connectors/Electron/tests packages/connectors/Tauri/tests packages/pulsify-react/tests packages/pulsify-vue/tests && bun test --conditions browser packages/pulsify-svelte/tests packages/pulsify-solid/tests",
		"check": "bun run typecheck && bun run test && bun run test:crdt && bun run test:database",
		"build": "bun scripts/build.ts",
		"bench": "bun benchmarks/index.ts",
		"bench:compare": "bun benchmarks/compare.ts",
		"test:rust": "cargo test --manifest-path crates/pulsify-protocol/Cargo.toml",
		"test:interop": "bun test tests/interop.test.ts",
		"test:rocksdb": "cargo test --locked --manifest-path crates/pulsify-rocksdb/Cargo.toml && bun test tests/rocksdb.test.ts",
		"test:runtimes": "bun scripts/test-runtimes.ts",
		"test:workers": "bun scripts/test-workers.ts",
		"test:cloud": "bun scripts/test-cloud.ts",
		"cloud:unikraft": "bun scripts/unikraft-cloud.ts",
		"cloud:schema": "bun scripts/generate-cloud-schema.ts",
		"test:codec-local": "bun scripts/test-codec-local.ts",
		"test:example": "bun scripts/test-example.ts",
		"test:prosemirror": "bun scripts/test-prosemirror.ts",
		"test:lexical": "EDITOR_DEMO=lexical bun scripts/test-prosemirror.ts",
		"test:package": "bun scripts/test-package.ts",
		"bench:crdt": "bun benchmarks/crdt-comparison.ts",
		"test:crdt": "bun test benchmarks/crdt-adapters.test.ts",
		"test:storage": "bun test packages/pulse/tests/storage.test.ts",
		"bench:storage:postgres": "bun scripts/bench-storage-postgres.ts",
		"bench:database": "bun benchmarks/database/native.ts",
		"bench:database:legacy": "bun benchmarks/database/docker.ts",
		"test:database": "bun test benchmarks/database/store.test.ts",
		"test:database:rust": "cargo test --locked --manifest-path crates/pulsify-db-bench/Cargo.toml --no-default-features",
		"format:check": "bun fmt --check",
		"format:fix": "bun fmt",
		"dev:website": "bun run --cwd packages/website dev",
		"build:website": "bun run --cwd packages/website build",
		"deploy:website": "bun run build:website && bunx wrangler deploy -c packages/website/wrangler.jsonc",
		"deploy:cloudflare": "bunx wrangler deploy -c packages/cloud-server/cloudflare/wrangler.jsonc",
		"deploy:service": "bunx wrangler deploy -c packages/cloud-service/wrangler.jsonc"
	},
	"trustedDependencies": [
		"better-sqlite3"
	],
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@gin-quin/codec": "2.1.1",
		"@lexical/headless": "^0.53.0",
		"@lexical/history": "^0.53.0",
		"@lexical/link": "^0.53.0",
		"@lexical/list": "^0.53.0",
		"@lexical/rich-text": "^0.53.0",
		"@lexical/selection": "^0.53.0",
		"@playwright/test": "^1.56.1",
		"@types/jsdom": "^30.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.3",
		"lexical": "^0.53.0",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-schema-basic": "^1.2.5",
		"prosemirror-schema-list": "^1.6.0",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.5",
		"prosemirror-view": "^1.42.9",
		"pulsify-codemirror": "workspace:*",
		"pulsify-lexical": "workspace:*",
		"pulsify-prosemirror": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"solid-js": "^1.9.19",
		"svelte": "^5.57.3",
		"typescript": "^7.0.2",
		"vue": "^3.5.45",
		"wrangler": "4.160.1"
	}
}
